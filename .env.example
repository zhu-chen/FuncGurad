# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and is loaded automatically at startup.
# Real environment variables always take precedence over these values.

# auto: use a real model when an API key is present, otherwise fall back to stub.
# openai / zhipu / glm: require a key and fail loudly if it is missing.
# stub: force the deterministic stub provider.
FUNCGUARD_LLM_PROVIDER=auto

# Zhipu OpenAI-compatible model API (GLM-5.3-Flash).
FUNCGUARD_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FUNCGUARD_LLM_MODEL=glm-5.3-flash
FUNCGUARD_LLM_API_KEY=your-api-key-here

# Sampling and limits
FUNCGUARD_LLM_TEMPERATURE=0.0
FUNCGUARD_LLM_MAX_TOKENS=16384
# 1 = SSE streaming (recommended for GLM-5.3-Flash long thinking)
FUNCGUARD_LLM_STREAM=1
# GLM-5.3-Flash supports low / high / max; low keeps evaluation latency manageable
FUNCGUARD_LLM_REASONING_EFFORT=low
FUNCGUARD_LLM_RETRIES=2
FUNCGUARD_LLM_TIMEOUT=180
FUNCGUARD_AGENT_MAX_STEPS=10
FUNCGUARD_AGENT_TIMEOUT=600
FUNCGUARD_AGENT_MAX_TOOL_CONTENT=16000

# Optional proxy (no default is applied)
# FUNCGUARD_LLM_PROXY=http://127.0.0.1:7897
# FUNCGUARD_GIT_PROXY=http://127.0.0.1:7897